 	pmdk_dai = devm_kzalloc(&pdev->dev, num_dp * sizeof(*pmdk_dai), GFP_KERNEL);
 	if (!pmdk_dai)
 		return -ENOMEM;
 
 	switch (num_dp) {
 	case 1:
-		pmdk_dai[0] = pmdk_dai0;
+		if (dp_mask == 1)
+			pmdk_dai[0] = pmdk_dai0;
